# Generate a random secret, for example with openssl rand -base64 48.
JWT_SECRET_KEY=""
DATABASE_URL="mongodb://127.0.0.1:27017/aftermath"
PORT="8080"
# Comma-separated exact origins; HTTPS is required in production.
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"
# Leave empty for direct connections. Set only the actual reverse-proxy IP/CIDRs.
TRUST_PROXY_CIDRS=""
